{
  "id": "international-climate-conference-assessment",
  "name": "기후국제회의 수행평가",
  "displayName": "기후국제회의 수행평가",
  "subject": "국제 관계와 국제기구",
  "unit": "5단원 환경과 에너지",
  "type": "server",
  "version": "2.3.1",
  "description": "기존 등록 프로그램 「기후국제회의 수행평가」용 v2.3.1 패치. v2.3.0의 국가배정 룰렛·자료 배경 강화·5억 단위 예산을 유지하고, 인권정책 수행평가와 같은 문장 작성 원칙을 핵심 서술형 4개에 적용해 최소 100자·권장 300자로 통일. 권장 분량은 강제하지 않고 자료 근거·판단 연결과 무성의 입력 방지를 중점 평가.",
  "theme": {
    "name": "green",
    "primary": "#1f6b45",
    "secondary": "#2d8056",
    "soft": "#e7f5ec"
  },
  "assessment": {
    "lessons": 2,
    "totalMinutes": 90,
    "recommendedMinutesPerLesson": 45,
    "totalPoints": 100,
    "phase1Steps": 5,
    "phase2Steps": 5,
    "rubric": {
      "dataAnalysis": 15,
      "nationalDecision": 15,
      "budgetTradeoff": 20,
      "internationalRelations": 15,
      "compromise": 15,
      "governance": 10,
      "reflectionFinal": 10
    }
  },
  "routes": {
    "student": "/",
    "teacher": "/teacher",
    "health": "/health",
    "teacherAliases": [
      "/?teacher=1",
      "/?mode=teacher",
      "/teacher/",
      "/teacher.html"
    ]
  },
  "runtime": {
    "kind": "node",
    "node": ">=20",
    "startCommand": "npm start",
    "portEnv": "PORT"
  },
  "environment": [
    {
      "name": "TEACHER_PASSWORD",
      "required": false,
      "description": "교사용 관리 비밀번호. 로그인 화면에는 표시하지 않음."
    },
    {
      "name": "DATA_DIR",
      "required": false,
      "default": "./data",
      "description": "학생 답안 영구 저장 경로"
    }
  ],
  "persistentPaths": [
    "data"
  ],
  "entry": "server.js",
  "mobile": {
    "optimized": true,
    "targetWidth": "360-430px",
    "stickyNavigation": true,
    "inputFontSize": "16px"
  },
  "slug": "기후국제회의-수행평가",
  "programName": "기후국제회의 수행평가",
  "targetProgramName": "기후국제회의 수행평가",
  "patchFor": "기후국제회의 수행평가",
  "patchType": "existing-program-patch",
  "operatePath": "/operate",
  "features": [
    "classroom-operation-display",
    "live-aggregate-progress",
    "classroom-90min-timer",
    "auto-manual-step-display",
    "presentation-mode",
    "country-background-preview",
    "country-assignment-roulette",
    "country-context-modal",
    "5-billion-budget-steps",
    "human-rights-style-writing-guidance",
    "100-char-minimum-core-writing",
    "300-char-recommended-core-writing"
  ]
}
