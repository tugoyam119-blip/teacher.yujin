{
  "id": "international-climate-conference-assessment",
  "name": "기후국제회의 수행평가",
  "displayName": "기후국제회의 수행평가",
  "subject": "국제 관계와 국제기구",
  "unit": "5단원 환경과 에너지",
  "type": "server",
  "version": "2.4.1",
  "description": "기존 등록 프로그램 「기후국제회의 수행평가」용 v2.4.1 패치. v2.4.0 운영·AI 가채점 기능을 유지하면서 교사용 페이지 안에서 OPENAI_API_KEY를 안전하게 입력·서버 저장·연결 확인·삭제할 수 있는 설정 UI를 추가.",
  "theme": {
    "name": "green",
    "primary": "#1f6b45",
    "secondary": "#2d8056",
    "soft": "#e7f5ec"
  },
  "assessment": {
    "lessons": 2,
    "totalMinutes": 90,
    "recommendedMinutesPerLesson": 45,
    "totalPoints": 100,
    "phase1Steps": 5,
    "phase2Steps": 5,
    "rubric": {
      "dataAnalysis": 15,
      "nationalDecision": 15,
      "budgetTradeoff": 20,
      "internationalRelations": 15,
      "compromise": 15,
      "governance": 10,
      "reflectionFinal": 10
    },
    "phaseGate": false
  },
  "routes": {
    "student": "/",
    "teacher": "/teacher",
    "health": "/health",
    "teacherAliases": [
      "/?teacher=1",
      "/?mode=teacher",
      "/teacher/",
      "/teacher.html"
    ]
  },
  "runtime": {
    "kind": "node",
    "node": ">=20",
    "startCommand": "npm start",
    "portEnv": "PORT"
  },
  "environment": [
    {
      "name": "TEACHER_PASSWORD",
      "required": false,
      "description": "교사용 관리 비밀번호. 로그인 화면에는 표시하지 않음."
    },
    {
      "name": "OPENAI_API_KEY",
      "required": false,
      "description": "AI 가채점 사용 시 필요한 OpenAI API 키. 미설정 시 AI 가채점만 비활성화됨."
    },
    {
      "name": "OPENAI_MODEL",
      "required": false,
      "default": "gpt-5.6-luna",
      "description": "AI 가채점 모델. 기본값 gpt-5.6-luna."
    },
    {
      "name": "DATA_DIR",
      "required": false,
      "default": "./data",
      "description": "학생 답안·명단·타이머 상태 영구 저장 경로"
    }
  ],
  "persistentPaths": [
    "data"
  ],
  "entry": "server.js",
  "mobile": {
    "optimized": true,
    "targetWidth": "360-430px",
    "stickyNavigation": true,
    "inputFontSize": "16px"
  },
  "slug": "기후국제회의-수행평가",
  "programName": "기후국제회의 수행평가",
  "targetProgramName": "기후국제회의 수행평가",
  "patchFor": "기후국제회의 수행평가",
  "patchType": "existing-program-patch",
  "operatePath": "/operate",
  "features": [
    "classroom-operation-display",
    "live-aggregate-progress",
    "auto-manual-step-display",
    "presentation-mode",
    "country-background-preview",
    "country-assignment-roulette",
    "country-context-modal",
    "5-billion-budget-steps",
    "human-rights-style-writing-guidance",
    "100-char-minimum-core-writing",
    "300-char-recommended-core-writing",
    "continuous-step-flow",
    "roulette-external-labels",
    "assigned-country-highlighting",
    "all-writing-length-guidance",
    "pre-submit-full-review-edit",
    "teacher-global-student-timer-pause-resume",
    "future-roster-csv-upload",
    "not-started-and-class-filters",
    "balanced-country-assignment-per-class",
    "reopen-submitted-to-final-review",
    "ai-provisional-grading",
    "ai-evidence-highlighting",
    "one-point-manual-scoring",
    "fully-korean-csv",
    "teacher-openai-api-key-input",
    "server-side-api-key-storage",
    "openai-api-connection-test"
  ]
}